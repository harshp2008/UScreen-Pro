# systemd user unit that runs the UScreen daemon with the graphical session (`uscreen --helper ... start`, stopped by `uscreen stop`).
# Owns start/stop and ordering; the installer and `make install` copy it to ~/.config/systemd/user. Does not own the daemon's settings.
# PLATFORM(systemd): user unit; %h is systemd's home specifier
[Unit]
Description=UScreen - USB Second Display Server
Documentation=https://github.com/majmichu1/UScreen
# Bound to the desktop session rather than to login: the daemon talks to the
# compositor (to place the virtual output and to map the tablet's touch and pen
# onto it), so starting before KWin exists would leave it retrying for nothing.
After=graphical-session.target gnome-session-initialized.target
StartLimitIntervalSec=120
StartLimitBurst=4
PartOf=graphical-session.target

[Service]
Type=simple
# No --edid here on purpose: passing one pins the virtual display to a single
# baked-in resolution and disables auto-resolution, so the display would stop
# following the tablet. Without it the daemon generates an EDID at runtime for
# whatever resolution is configured or reported.
ExecStart=%h/.local/bin/uscreen --helper %h/.local/bin/evdi_helper start
ExecStop=%h/.local/bin/uscreen stop
# Compositor safety (experiments_and_findings/56_evdi_mutter_freeze_rca.md):
# the daemon creates a monitor on the desktop, so it must never compete with the
# compositor for the CPU, and must be the first thing the OOM killer takes.
Nice=5
CPUWeight=50
OOMScoreAdjust=300
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical-session.target
