{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UScreen Pro",
  "version": "1.3.0",
  "identifier": "com.uscreen.pro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "UScreen Pro",
        "width": 1024,
        "height": 720,
        "minWidth": 860,
        "minHeight": 580,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
